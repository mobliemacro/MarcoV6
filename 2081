-- FAKE LOADING STEPS  (timed across DisplayTime)
-- ============================================================

local steps      = CONFIG.Steps
local stepCount  = #steps
local timePerStep = CONFIG.DisplayTime / stepCount
local dotConn

-- Dot pulse
local dotTick = 0
dotConn = RunService.Heartbeat:Connect(function()
	dotTick += 1
	if dotTick % 28 == 0 then
		local d = string.rep(".", (math.floor(dotTick / 28) % 4))
		statusLabel.Text = "LOADING" .. d
	end
end)

task.spawn(function()
	for i, step in ipairs(steps) do
		local progress = i / stepCount

		-- Fade step label
		TweenService:Create(stepLabel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextTransparency = 1}):Play()
		task.wait(0.25)
		stepLabel.Text = step
		TweenService:Create(stepLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {TextTransparency = 0.4}):Play()

		-- Advance bar
		TweenService:Create(barFill, TweenInfo.new(timePerStep * 0.85, Enum.EasingStyle.Quad), {
			Size = UDim2.new(math.min(progress, 0.95), 0, 1, 0)
		}):Play()
		percentLabel.Text = math.floor(math.min(progress, 0.95) * 100) .. "%"

		task.wait(timePerStep)
	end

	-- Finish bar
	TweenService:Create(barFill, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
		Size = UDim2.new(1, 0, 1, 0)
	}):Play()
	percentLabel.Text = "100%"
	statusLabel.Text  = "DONE"
	task.wait(0.4)

	-- ============================================================
	-- FADE OUT
	-- ============================================================
	dotConn:Disconnect()

	local fadeInfo = TweenInfo.new(CONFIG.FadeOutDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

	TweenService:Create(root, fadeInfo, {BackgroundTransparency = 1}):Play()

	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("TextLabel") then
			TweenService:Create(desc, fadeInfo, {TextTransparency = 1}):Play()
		elseif desc:IsA("Frame") then
			TweenService:Create(desc, fadeInfo, {BackgroundTransparency = 1}):Play()
		end
	end

	task.wait(CONFIG.FadeOutDuration + 0.15)
	screenGui:Destroy()
end)

